		Position = UDim2.fromOffset(50, 13),
		Size = UDim2.new(1, -56, 0, 14),
		Text = options.Title or "Title",
		TextColor3 = Theme.Accent,
		Font = Fonts.Bold,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
