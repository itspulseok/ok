		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 10, 1, -58),
		Size = UDim2.new(1, -21, 0, 48),
		Parent = sidebar,
	}, { corner(6), stroke(Theme.Border, 0.35) })
	local profileAvatar = new("ImageLabel", {
		BackgroundColor3 = Theme.Control,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(32, 32),
		Parent = profile,
	}, { corner(16) })
	self.ProfileName = text({
		Position = UDim2.fromOffset(46, 7),
		Size = UDim2.new(1, -52, 0, 15),
		Text = "",
		Font = Fonts.Bold,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = profile,
	})
	self.ProfileUser = text({
		Position = UDim2.fromOffset(46, 23),
		Size = UDim2.new(1, -52, 0, 14),
		Text = "",
		TextColor3 = Theme.Muted,
		Font = Fonts.Medium,
		TextSize = 11,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = profile,
	})
	task.spawn(function()
		while profile.Parent do
			local ok, plr = pcall(function() return Players.LocalPlayer end)
			if ok and plr then
				self.ProfileName.Text = plr.DisplayName
				self.ProfileUser.Text = "@" .. plr.Name
				if profileAvatar.Image == "" then
					local ok2, thumb = pcall(function()
						return Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
					end)
					if ok2 and thumb then
						profileAvatar.Image = thumb
					end
				end
			end
			task.wait(2)
		end
	end)

	self.Content = new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(Config.SidebarWidth + 12, Config.HeaderHeight + 10),
		Size = UDim2.new(1, -(Config.SidebarWidth + 24), 1, -(Config.HeaderHeight + 22)),
		Parent = root,
	})

	self.Overlay = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(),
		ZIndex = 50,
		Parent = root,
	})

	self.NotifyStack = new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.fromOffset(240, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = gui,
	}, { list(8) })

	local dragging = false
	local dragStart, rootStart
	local function beginDrag(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		dragging = true
		dragStart = input.Position
		rootStart = root.Position
	end
	connect(header.InputBegan, beginDrag)
	connect(dragArea.InputBegan, beginDrag)
	connect(UserInputService.InputChanged, function(input)
		if not dragging then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local delta = input.Position - dragStart
		root.Position = UDim2.new(
			rootStart.X.Scale, rootStart.X.Offset + delta.X,
			rootStart.Y.Scale, rootStart.Y.Offset + delta.Y
		)
	end)
	connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	mountGui(gui)
	return self
end

function Window:SetOpen(state)
	if self.Open == state then
		return
	end
	self.Open = state
	local root = self.Root
	if state then
		root.Visible = true
		root.GroupTransparency = 1
		self.Scale.Scale = 0.97
		tween(root, { GroupTransparency = 0 }, Motion.Smooth)
		tween(self.Scale, { Scale = 1 }, Motion.Pop)
		return
	end
	tween(self.Scale, { Scale = 0.97 }, Motion.Smooth)
	tween(root, { GroupTransparency = 1 }, Motion.Smooth).Completed:Once(function()
		if not self.Open then
			root.Visible = false
		end
	end)
end

function Window:Toggle()
	self:SetOpen(not self.Open)
end

function Window:SetTitle(title, subtitle)
	if title then
		self.TitleLabel.Text = title
	end
	if subtitle then
		self.SubtitleLabel.Text = subtitle
	end
end

function Window:nextNavOrder()
	self.NavOrder += 1
	return self.NavOrder
end

function Window:AddTab(name, iconName, fallback)
	local window = self
	local tab = setmetatable({
		Window = self,
		Name = name,
		Groupboxes = {},
		LeftOrder = 0,
		RightOrder = 0,
	}, Tab)

	local item = new("Frame", {
		BackgroundColor3 = Theme.Card,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, Config.NavHeight),
		ClipsDescendants = true,
		LayoutOrder = self:nextNavOrder(),
		Parent = self.Nav,
	}, { corner(6) })
	local bar = new("Frame", {
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, -3, 0.5, 0),
		Size = UDim2.new(0, 3, 0, 20),
		Parent = item,
	}, { corner(2) })
	local glyph, _, glyphColor = icon(item, iconName, fallback or string.sub(name, 1, 1), 17, Theme.Muted)
	glyph.AnchorPoint = Vector2.new(0, 0.5)
	glyph.Position = UDim2.new(0, 13, 0.5, 0)
	local label = text({
		Position = UDim2.fromOffset(40, 0),
		Size = UDim2.new(1, -64, 1, 0),
		Text = name,
		TextColor3 = Theme.Muted,
		Font = Fonts.Medium,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = item,
	})
	local more, _, moreColor = icon(item, "ellipsis-vertical", ":", 14, Theme.Dim)
	more.AnchorPoint = Vector2.new(1, 0.5)
	more.Position = UDim2.new(1, -10, 0.5, 0)
	local button = clickable(item)
	tab.Item = item

	local container = new("CanvasGroup", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		GroupTransparency = 1,
		Visible = false,
		Parent = self.Content,
	})
	tab.Container = container

	local function column(side)
		return new("ScrollingFrame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = side == "Left" and UDim2.new() or UDim2.new(0.5, 5, 0, 0),
			Size = UDim2.new(0.5, -5, 1, 0),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = Theme.Track,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Parent = container,
		}, { list(8), padding(1, 4, 1, 1) })
	end
	tab.Left = column("Left")
	tab.Right = column("Right")

	local function paint(active, hovered)
		tween(item, { BackgroundTransparency = active and 0 or (hovered and 0.6 or 1) }, Motion.Quick)
		tween(bar, { Position = active and UDim2.new(0, 0, 0.5, 0) or UDim2.new(0, -3, 0.5, 0) }, Motion.Smooth)
		tween(glyph, { [glyphColor] = active and Theme.Accent or (hovered and Theme.Text or Theme.Muted) }, Motion.Quick)
		tween(label, { TextColor3 = active and Theme.Accent or (hovered and Theme.Text or Theme.Muted) }, Motion.Quick)
		tween(more, { [moreColor] = (active or hovered) and Theme.Muted or Theme.Dim }, Motion.Quick)
	end
	tab.paint = paint

	connect(button.MouseEnter, function()
		if window.ActiveTab ~= tab then
			paint(false, true)
		end
	end)
	connect(button.MouseLeave, function()
		if window.ActiveTab ~= tab then
			paint(false, false)
		end
	end)
	connect(button.MouseButton1Click, function()
		tab:Select()
	end)

	self.Tabs[#self.Tabs + 1] = tab
	if not self.ActiveTab then
		tab:Select()
	end
	return tab
end

function Tab:Select()
	local window = self.Window
	if window.ActiveTab == self then
		return
	end
	local previous = window.ActiveTab
	window.ActiveTab = self

	if previous then
		previous.paint(false, false)
		local exit = tween(previous.Container, { GroupTransparency = 1 }, Motion.Quick)
		exit.Completed:Once(function()
			if window.ActiveTab ~= previous then
				previous.Container.Visible = false
			end
		end)
	end

	self.paint(true, false)
	self.Container.Visible = true
	self.Container.GroupTransparency = 1
	self.Container.Position = UDim2.fromOffset(0, 8)
	tween(self.Container, { GroupTransparency = 0, Position = UDim2.new() }, Motion.Smooth)
end

function Tab:addGroupbox(side, title)
	local groupbox = setmetatable({
		Tab = self,
		Rows = {},
		RowOrder = 0,
		Collapsed = false,
	}, Groupbox)

	local order
	if side == "Left" then
		self.LeftOrder += 1
		order = self.LeftOrder
	else
		self.RightOrder += 1
		order = self.RightOrder
	end

	local card = new("Frame", {
		BackgroundColor3 = Theme.Card,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ClipsDescendants = true,
		LayoutOrder = order,
		Parent = side == "Left" and self.Left or self.Right,
	}, { corner(6), stroke(Theme.Border, 0.35), list(0) })
	groupbox.Card = card

	local head = new("Frame", {
		BackgroundColor3 = Theme.Control,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, Config.CardHeaderHeight),
		LayoutOrder = 0,
		Parent = card,
	})
	groupbox.TitleLabel = text({
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -36, 1, 0),
		Text = title or "",
		TextColor3 = Theme.Muted,
		Font = Fonts.Medium,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = head,
	})
	local chevron = icon(head, "chevron-down", "v", 12, Theme.Muted)
	chevron.AnchorPoint = Vector2.new(1, 0.5)
	chevron.Position = UDim2.new(1, -9, 0.5, 0)
	local headButton = clickable(head)

	local body = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ClipsDescendants = true,
		LayoutOrder = 1,
		Parent = card,
	}, { padding(8, 10, 10, 10), list(4) })
	groupbox.Body = body

	local function setCollapsed(state)
		if groupbox.Collapsed == state then
			return
		end
		groupbox.Collapsed = state
		tween(chevron, { Rotation = state and -90 or 0 }, Motion.Smooth)
		if state then
			local height = body.AbsoluteSize.Y / self.Window.Scale.Scale
			body.AutomaticSize = Enum.AutomaticSize.None
			body.Size = UDim2.new(1, 0, 0, height)
			tween(body, { Size = UDim2.new(1, 0, 0, 0) }, Motion.Smooth).Completed:Once(function()
				if groupbox.Collapsed then
					body.Visible = false
				end
			end)
			return
		end
		body.Visible = true
		local content = body:FindFirstChildOfClass("UIListLayout")
		local target = content.AbsoluteContentSize.Y / self.Window.Scale.Scale + 18
		tween(body, { Size = UDim2.new(1, 0, 0, target) }, Motion.Smooth).Completed:Once(function()
			if not groupbox.Collapsed then
				body.AutomaticSize = Enum.AutomaticSize.Y
				body.Size = UDim2.new(1, 0, 0, 0)
			end
		end)
	end
	groupbox.SetCollapsed = function(_, state)
		setCollapsed(state)
	end

	connect(headButton.MouseButton1Click, function()
		setCollapsed(not groupbox.Collapsed)
	end)
	hoverable(headButton, head, Theme.Control, Theme.Track)

	self.Groupboxes[#self.Groupboxes + 1] = groupbox
	return groupbox
end

function Tab:AddLeftGroupbox(title)
	return self:addGroupbox("Left", title)
end

function Tab:AddRightGroupbox(title)
	return self:addGroupbox("Right", title)
end

function Groupbox:SetTitle(title)
	self.TitleLabel.Text = title
end

function Groupbox:row(height, labelText)
	self.RowOrder += 1
	local frame = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height),
		LayoutOrder = self.RowOrder,
		Parent = self.Body,
	})
	self.Rows[#self.Rows + 1] = { Frame = frame, Text = string.lower(labelText or "") }
	return frame
end

function Groupbox:rowLabel(frame, labelText, reserve)
	return text({
		Size = UDim2.new(1, -(reserve or 0), 1, 0),
		Text = labelText,
		Font = Fonts.Medium,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
end

local function setEnabledLook(label, control, enabled)
	tween(label, { TextColor3 = enabled and Theme.Text or Theme.Dim }, Motion.Quick)
	if control then
		tween(control, { BackgroundTransparency = enabled and 0 or 0.4 }, Motion.Quick)
	end
end

local function fireChanged(entry, value)
	if entry.Callback then
		entry.Callback(value)
	end
	for _, listener in entry.Listeners do
		listener(value)
	end
end

local function baseEntry(kind, options, frame)
	return {
		Type = kind,
		Row = frame,
		Callback = options.Callback,
		NoSave = options.NoSave == true,
		Listeners = {},
		OnChanged = function(self, listener)
			self.Listeners[#self.Listeners + 1] = listener
			return self
		end,
	}
end

local KeyDisplay = {
	MouseButton1 = "MB1",
	MouseButton2 = "MB2",
	MouseButton3 = "MB3",
	LeftControl = "LCTRL",
	RightControl = "RCTRL",
	LeftShift = "LSHIFT",
	RightShift = "RSHIFT",
	LeftAlt = "LALT",
	RightAlt = "RALT",
}

local function resolveKey(value)
	if typeof(value) == "EnumItem" then
		return value
	end
	if type(value) ~= "string" or value == "" then
		return nil
	end
	local okKey, key = pcall(function()
		return Enum.KeyCode[value]
	end)
	if okKey and typeof(key) == "EnumItem" then
		return key
	end
	local okType, inputType = pcall(function()
		return Enum.UserInputType[value]
	end)
	if okType and typeof(inputType) == "EnumItem" then
		return inputType
	end
	return nil
end

function Groupbox:AddKeybind(index, options)
	options = options or {}
	local labelText = options.Text or index
	local frame = self:row(Config.RowHeight, labelText)
	local label = self:rowLabel(frame, labelText, 90)
	local tag = new("Frame", {
		BackgroundColor3 = Theme.Chrome,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = frame,
	}, { corner(4), padding(0, 7, 0, 7) })
	local tagStroke = stroke(Theme.Border, 0.4)
	tagStroke.Parent = tag
	local tagLabel = text({
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextColor3 = Theme.Muted,
		Font = Fonts.Medium,
		TextSize = 11,
		Parent = tag,
	})
	local button = clickable(tag)

	local entry = baseEntry("Keybind", options, frame)
	entry.Value = resolveKey(options.Default)
	entry.Mode = options.Mode or "Toggle"
	entry.MenuKey = options.MenuKey == true
	entry.Linked = options.Linked
	entry.Toggled = false
	entry.Capturing = false
	entry.Disabled = false

	local function render()
		local name = entry.Value and entry.Value.Name or "NONE"
		local shown = KeyDisplay[name] or string.upper(name)
		tagLabel.Text = entry.Capturing and "Key: ..." or "Key: " .. shown
		tween(tagLabel, { TextColor3 = entry.Capturing and Theme.Accent or Theme.Muted }, Motion.Quick)
		tween(tagStroke, {
			Color = entry.Capturing and Theme.Accent or Theme.Border,
			Transparency = entry.Capturing and 0.2 or 0.4,
		}, Motion.Quick)
	end
	entry.render = render

	function entry:SetValue(value, silent)
		local key = resolveKey(value)
		local changed = key ~= self.Value
		self.Value = key
		self.Capturing = false
		if Library.CapturingKeybind == self then
			Library.CapturingKeybind = nil
		end
		render()
		if changed and not silent then
			for _, listener in self.Listeners do
				listener(key)
			end
		end
	end

	function entry:SetMode(mode)
		self.Mode = mode
		self.Toggled = false
	end

	function entry:GetState()
		return self.Toggled
	end

	function entry:BeginCapture()
		local other = Library.CapturingKeybind
		if other and other ~= self then
			other.Capturing = false
			other.render()
		end
		self.Capturing = true
		Library.CapturingKeybind = self
		render()
	end

	function entry:SetDisabled(state)
		self.Disabled = state
		setEnabledLook(label, tag, not state)
		if state and self.Capturing then
			self:SetValue(self.Value, true)
		end
	end

	connect(button.MouseButton1Click, function()
		if entry.Disabled then
			return
		end
		if entry.Capturing then
			entry:SetValue(entry.Value, true)
			return
		end
		entry:BeginCapture()
	end)
	hoverable(button, tag, Theme.Chrome, Theme.Control)

	render()
	Library.Options[index] = entry
	Library.Keybinds[#Library.Keybinds + 1] = entry
	return entry
end

function Groupbox:AddToggle(index, options)
	options = options or {}
	local labelText = options.Text or index
	local frame = self:row(Config.RowHeight, labelText)
	local label = self:rowLabel(frame, labelText, 40)
	local track = new("Frame", {
		BackgroundColor3 = Theme.Control,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(30, 16),
		Parent = frame,
	}, { corner(8) })
	local trackStroke = stroke(Theme.Border, 0.4)
	trackStroke.Parent = track
	local knob = new("Frame", {
		BackgroundColor3 = Theme.Knob,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		Parent = track,
	}, { corner(6) })
	local button = clickable(frame)

	local entry = baseEntry("Toggle", options, frame)
	entry.Value = options.Default == true
	entry.Disabled = false
	entry.Groupbox = self
	entry.Text = labelText

	local function render(animate)
		local trackGoal = { BackgroundColor3 = entry.Value and Theme.Accent or Theme.Control }
		local knobGoal = { Position = entry.Value and UDim2.new(0, 16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0) }
		local strokeGoal = { Transparency = entry.Value and 1 or 0.4 }
		if animate then
			tween(track, trackGoal, Motion.Smooth)
			tween(knob, knobGoal, Motion.Pop)
			tween(trackStroke, strokeGoal, Motion.Quick)
			return
		end
		track.BackgroundColor3 = trackGoal.BackgroundColor3
		knob.Position = knobGoal.Position
		trackStroke.Transparency = strokeGoal.Transparency
	end

	function entry:SetValue(value, silent)
		value = value == true
		local changed = value ~= self.Value
		self.Value = value
		render(true)
		if changed and not silent then
			fireChanged(self, value)
		end
	end

	function entry:SetDisabled(state)
		self.Disabled = state
		setEnabledLook(label, track, not state)
	end

	function entry:AddKeybind(keyIndex, keyOptions)
		keyOptions = keyOptions or {}
		keyOptions.Text = keyOptions.Text or self.Text
		keyOptions.Linked = self
		return self.Groupbox:AddKeybind(keyIndex, keyOptions)
	end

	connect(button.MouseButton1Click, function()
		if entry.Disabled then
			return
		end
		entry:SetValue(not entry.Value)
	end)
	connect(button.MouseEnter, function()
		if not entry.Value and not entry.Disabled then
			tween(track, { BackgroundColor3 = Theme.Track }, Motion.Quick)
		end
	end)
	connect(button.MouseLeave, function()
		if not entry.Value then
			tween(track, { BackgroundColor3 = Theme.Control }, Motion.Quick)
		end
	end)

	render(false)
	Library.Toggles[index] = entry
	if entry.Value then
		fireChanged(entry, true)
	end
	return entry
end

function Groupbox:AddSlider(index, options)
	options = options or {}
	local labelText = options.Text or index
	local minimum = options.Min or 0
	local maximum = options.Max or 100
	local rounding = options.Rounding or 0
	local suffix = options.Suffix or ""
	local factor = 10 ^ rounding
	local format = "%." .. rounding .. "f"

	local frame = self:row(Config.RowHeight + 10, labelText)
	local label = text({
		Size = UDim2.new(0.65, 0, 0, 18),
		Text = labelText,
		Font = Fonts.Medium,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	local readout = text({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0.35, 0, 0, 18),
		Text = "",
		Font = Fonts.Medium,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame,
	})
	local track = new("Frame", {
		BackgroundColor3 = Theme.Track,
		Position = UDim2.fromOffset(0, 25),
		Size = UDim2.new(1, 0, 0, 3),
		Parent = frame,
	}, { corner(2) })
	local fill = new("Frame", {
		BackgroundColor3 = Theme.Accent,
		Size = UDim2.new(0, 0, 1, 0),
		Parent = track,
	}, { corner(2) })
	local knob = new("Frame", {
		BackgroundColor3 = Theme.Knob,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(9, 9),
		ZIndex = 2,
		Parent = track,
	}, { corner(5) })
	local hit = clickable(frame, UDim2.new(1, 0, 0, 16), UDim2.fromOffset(0, 18))

	local entry = baseEntry("Slider", options, frame)
	entry.Min = minimum
	entry.Max = maximum
	entry.Disabled = false

	local function clean(value)
		value = math.clamp(tonumber(value) or minimum, minimum, maximum)
		return math.floor(value * factor + 0.5) / factor
	end

	local function alphaOf(value)
		if maximum == minimum then
			return 0
		end
		return (value - minimum) / (maximum - minimum)
	end

	local function render(animate)
		local alpha = alphaOf(entry.Value)
		readout.Text = string.format(format, entry.Value) .. suffix
		local fillGoal = { Size = UDim2.new(alpha, 0, 1, 0) }
		local knobGoal = { Position = UDim2.new(alpha, 0, 0.5, 0) }
		if animate then
			tween(fill, fillGoal, Motion.Smooth)
			tween(knob, knobGoal, Motion.Smooth)
			return
		end
		fill.Size = fillGoal.Size
		knob.Position = knobGoal.Position
	end

	local function commit(value, animate)
		value = clean(value)
		local changed = value ~= entry.Value
		entry.Value = value
		render(animate)
		if changed then
			fireChanged(entry, value)
		end
	end

	function entry:SetValue(value)
		commit(value, true)
	end

	function entry:SetDisabled(state)
		self.Disabled = state
		setEnabledLook(label, nil, not state)
		tween(readout, { TextColor3 = state and Theme.Dim or Theme.Text }, Motion.Quick)
		tween(fill, { BackgroundColor3 = state and Theme.Dim or Theme.Accent }, Motion.Quick)
	end

	local dragging = false
	local function applyFromX(x)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		commit(minimum + (maximum - minimum) * alpha, false)
	end

	connect(hit.InputBegan, function(input)
		if entry.Disabled then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		dragging = true
		tween(knob, { Size = UDim2.fromOffset(12, 12) }, Motion.Quick)
		applyFromX(input.Position.X)
	end)
	connect(UserInputService.InputChanged, function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			applyFromX(input.Position.X)
		end
	end)
	connect(UserInputService.InputEnded, function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			tween(knob, { Size = UDim2.fromOffset(9, 9) }, Motion.Quick)
		end
	end)

	entry.Value = clean(options.Default or minimum)
	render(false)
	Library.Options[index] = entry
	return entry
end

local function captionedControl(groupbox, labelText)
	local frame = groupbox:row(Config.RowHeight + 22, labelText)
	local label = text({
		Size = UDim2.new(1, 0, 0, 18),
		Text = labelText,
		Font = Fonts.Medium,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	local control = new("Frame", {
		BackgroundColor3 = Theme.Control,
		Position = UDim2.fromOffset(0, 20),
		Size = UDim2.new(1, 0, 0, 24),
		Parent = frame,
	}, { corner(5) })
	local controlStroke = stroke(Theme.Border, 0.4)
	controlStroke.Parent = control
	return frame, label, control, controlStroke
end

function Groupbox:AddDropdown(index, options)
	options = options or {}
	local labelText = options.Text or index
	local multi = options.Multi == true
	local openUp = options.OpenUp == true
	local window = self.Tab.Window

	local frame, label, control, controlStroke = captionedControl(self, labelText)
	local display = text({
		Position = UDim2.fromOffset(9, 0),
		Size = UDim2.new(1, -34, 1, 0),
		Text = "",
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = control,
	})
	local grid, _, gridColor = icon(control, "layout-grid", "#", 12, Theme.Muted)
	grid.AnchorPoint = Vector2.new(1, 0.5)
	grid.Position = UDim2.new(1, -8, 0.5, 0)
	local button = clickable(control)

	local holder = new("CanvasGroup", {
		BackgroundColor3 = Theme.Control,
		Size = UDim2.fromOffset(0, 0),
		GroupTransparency = 1,
		Visible = false,
		ZIndex = 51,
		Parent = window.Overlay,
	}, { corner(5), stroke(Theme.Border, 0.2) })
	local inner = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = holder,
	}, { padding(4, 4, 4, 4), list(Config.OptionGap) })

	local entry = baseEntry("Dropdown", options, frame)
	entry.Values = options.Values or {}
	entry.Multi = multi
	entry.Disabled = false
	entry.Value = multi and {} or nil
	entry.Control = control
	entry.Holder = holder
	entry.Inner = inner

	local open = false
	local menuHeight = 0
	local optionRows = {}
	local rowButtons = {}

	local function selectedText()
		if multi then
			local parts = {}
			for _, value in entry.Values do
				if entry.Value[value] then
					parts[#parts + 1] = value
				end
			end
			return #parts > 0 and table.concat(parts, ", ") or "None"
		end
		return entry.Value or "None"
	end

	local function isSelected(value)
		if multi then
			return entry.Value[value] == true
		end
		return entry.Value == value
	end

	local function paintOptions()
		display.Text = selectedText()
		for value, row in optionRows do
			tween(row.Label, { TextColor3 = isSelected(value) and Theme.Accent or Theme.Muted }, Motion.Quick)
		end
	end

	local function setOpen(state)
		if open == state then
			return
		end
		open = state
		tween(grid, { [gridColor] = state and Theme.Accent or Theme.Muted }, Motion.Quick)
		tween(controlStroke, { Color = state and Theme.Accent or Theme.Border, Transparency = state and 0.4 or 0.4 }, Motion.Quick)
		if state then
			if window.OpenDropdown and window.OpenDropdown ~= entry then
				window.OpenDropdown:Close()
			end
			window.OpenDropdown = entry
			local scale = window.Scale.Scale
			local origin = (control.AbsolutePosition - window.Overlay.AbsolutePosition) / scale
			local width = control.AbsoluteSize.X / scale
			local below = origin.Y + control.AbsoluteSize.Y / scale + 4
			local rootHeight = window.Root.AbsoluteSize.Y / scale
			local y = below
			if openUp then
				y = math.max(origin.Y - menuHeight - 4, 4)
			elseif below + menuHeight > rootHeight and origin.Y - menuHeight - 4 >= 0 then
				y = origin.Y - menuHeight - 4
			end
			holder.Position = UDim2.fromOffset(origin.X, y)
			holder.Size = UDim2.fromOffset(width, 0)
			holder.Visible = true
			tween(holder, { Size = UDim2.fromOffset(width, menuHeight), GroupTransparency = 0 }, Motion.Smooth)
			return
		end
		if window.OpenDropdown == entry then
			window.OpenDropdown = nil
		end
		local collapse = tween(holder, { Size = UDim2.fromOffset(holder.Size.X.Offset, 0), GroupTransparency = 1 }, Motion.Smooth)
		collapse.Completed:Once(function()
			if not open then
				holder.Visible = false
			end
		end)
	end

	function entry:Close()
		setOpen(false)
	end

	function entry:IsInside(_position)
		local mouse = UserInputService:GetMouseLocation()
		local function within(instance)
			if not instance or not instance.Parent then
				return false
			end
			local topLeft = instance.AbsolutePosition
			local size = instance.AbsoluteSize
			return mouse.X >= topLeft.X and mouse.X <= topLeft.X + size.X
				and mouse.Y >= topLeft.Y and mouse.Y <= topLeft.Y + size.Y
		end
		if within(control) or within(holder) or within(inner) then
			return true
		end
		for _, btn in ipairs(rowButtons) do
			if within(btn) then
				return true
			end
		end
		return false
	end

	local function toggleOption(value)
		if multi then
			entry.Value[value] = not entry.Value[value] or nil
			paintOptions()
			fireChanged(entry, entry.Value)
			return
		end
		local changed = entry.Value ~= value
		entry.Value = value
		paintOptions()
		setOpen(false)
		if changed then
			fireChanged(entry, value)
		end
	end

	local function buildOptions()
		for _, row in optionRows do
			row.Frame:Destroy()
		end
		optionRows = {}
		rowButtons = {}
		for order, value in entry.Values do
			local row = new("Frame", {
				BackgroundColor3 = Theme.Track,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, Config.OptionHeight),
				LayoutOrder = order,
				Parent = inner,
			}, { corner(4) })
			local rowLabel = text({
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.new(1, -16, 1, 0),
				Text = value,
				TextColor3 = Theme.Muted,
				TextSize = 12,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = row,
			})
			local rowButton = clickable(row)
			rowButton.ZIndex = 60
			connect(rowButton.MouseEnter, function()
				tween(row, { BackgroundTransparency = 0 }, Motion.Quick)
			end)
			connect(rowButton.MouseLeave, function()
				tween(row, { BackgroundTransparency = 1 }, Motion.Quick)
			end)
			connect(rowButton.MouseButton1Down, function()
				toggleOption(value)
			end)
			optionRows[value] = { Frame = row, Label = rowLabel }
			rowButtons[#rowButtons + 1] = rowButton
		end
		local count = #entry.Values
		menuHeight = count * Config.OptionHeight + math.max(count - 1, 0) * Config.OptionGap + 8
		paintOptions()
	end

	function entry:SetValue(value, silent)
		if multi then
			local next = {}
			if type(value) == "table" then
				for key, flag in value do
					local name = type(key) == "number" and flag or key
					if type(name) == "string" and table.find(self.Values, name) and flag then
						next[name] = true
					end
				end
			elseif type(value) == "string" and table.find(self.Values, value) then
				next[value] = true
			end
			self.Value = next
		else
			self.Value = (type(value) == "string" and table.find(self.Values, value)) and value or nil
		end
		paintOptions()
		if not silent then
			fireChanged(self, self.Value)
		end
	end

	function entry:SetValues(values, keepSelection)
		self.Values = values or {}
		buildOptions()
		if keepSelection then
			self:SetValue(self.Value, true)
		else
			self:SetValue(multi and {} or nil, true)
		end
		if open then
			tween(holder, { Size = UDim2.fromOffset(holder.Size.X.Offset, menuHeight) }, Motion.Smooth)
		end
	end

	function entry:SetDisabled(state)
		self.Disabled = state
		setEnabledLook(label, control, not state)
		if state then
			setOpen(false)
		end
	end

	connect(button.MouseButton1Click, function()
		if entry.Disabled then
			return
		end
		setOpen(not open)
	end)
	hoverable(button, control, Theme.Control, Theme.Track)

	buildOptions()
	entry:SetValue(options.Default, true)
	Library.Options[index] = entry
	return entry
end

function Groupbox:AddInput(index, options)
	options = options or {}
	local labelText = options.Text or index
	local frame, label, control, controlStroke = captionedControl(self, labelText)
	local box = new("TextBox", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(9, 0),
		Size = UDim2.new(1, -18, 1, 0),
		Font = Fonts.Regular,
		TextSize = 12,
		TextColor3 = Theme.Text,
		PlaceholderText = options.Placeholder or "",
		PlaceholderColor3 = Theme.Dim,
		Text = options.Default or "",
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = control,
	})

	local entry = baseEntry("Input", options, frame)
	entry.Value = box.Text
	entry.Box = box
	entry.Disabled = false

	local function accept(rawText, silent)
		if options.Numeric and rawText ~= "" and tonumber(rawText) == nil then
			box.Text = entry.Value
			return
		end
		local changed = rawText ~= entry.Value
		entry.Value = rawText
		if changed and not silent then
			fireChanged(entry, rawText)
		end
	end

	function entry:SetValue(value, silent)
		box.Text = tostring(value == nil and "" or value)
		accept(box.Text, silent)
	end

	function entry:SetDisabled(state)
		self.Disabled = state
		box.TextEditable = not state
		setEnabledLook(label, control, not state)
	end

	connect(box.Focused, function()
		tween(controlStroke, { Color = Theme.Accent, Transparency = 0.2 }, Motion.Quick)
	end)
	connect(box.FocusLost, function(enterPressed)
		tween(controlStroke, { Color = Theme.Border, Transparency = 0.4 }, Motion.Quick)
		if options.Finished then
			if enterPressed then
				accept(box.Text)
			else
				box.Text = entry.Value
			end
			return
		end
		accept(box.Text)
	end)
	if not options.Finished then
		connect(box:GetPropertyChangedSignal("Text"), function()
			if box:IsFocused() then
				accept(box.Text)
			end
		end)
	end

	Library.Options[index] = entry
	return entry
end

