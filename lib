local function keybindMatches(entry, input)
	local key = entry.Value
	if not key then
		return false
	end
	if input.UserInputType == Enum.UserInputType.Keyboard then
		return input.KeyCode == key
	end
	return input.UserInputType == key
end

local function setKeybindState(entry, state)
	entry.Toggled = state
	if entry.Linked then
		entry.Linked:SetValue(state)
	end
	if entry.Callback then
		entry.Callback(state)
	end
end

connect(UserInputService.InputBegan, function(input, gameProcessed)
	local capturing = Library.CapturingKeybind
	if capturing then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
				capturing:SetValue(nil)
			else
				capturing:SetValue(input.KeyCode)
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
			capturing:SetValue(input.UserInputType)
		end
		return
	end

	if UserInputService:GetFocusedTextBox() then
		return
	end

	local window = Library.Window
	if window and window.OpenDropdown and input.UserInputType == Enum.UserInputType.MouseButton1 then
		local entry = window.OpenDropdown
		if entry.Disabled then
			entry:Close()
		else
			task.defer(function()
				if window.OpenDropdown == entry and not entry:IsInside(UserInputService:GetMouseLocation()) then
					entry:Close()
				end
			end)
		end
	end

	for _, entry in Library.Keybinds do
		if entry.Disabled or not keybindMatches(entry, input) then
			continue
		end
		if entry.MenuKey then
			if not gameProcessed and window then
				window:Toggle()
			end
			continue
		end
		if entry.Mode == "Toggle" then
			local current = entry.Linked and entry.Linked.Value or entry.Toggled
			setKeybindState(entry, not current)
		elseif entry.Mode == "Hold" then
			setKeybindState(entry, true)
		elseif entry.Callback then
			entry.Callback(true)
		end
	end
end)

connect(UserInputService.InputEnded, function(input)
	for _, entry in Library.Keybinds do
		if entry.Mode == "Hold" and entry.Toggled and keybindMatches(entry, input) then
			setKeybindState(entry, false)
		end
	end
end)

function Library:GetConfig()
	local data = { Toggles = {}, Options = {} }
	for index, entry in self.Toggles do
		if not entry.NoSave then
			data.Toggles[index] = entry.Value
		end
	end
	for index, entry in self.Options do
		if entry.NoSave then
			continue
		end
		if entry.Type == "Keybind" then
			data.Options[index] = entry.Value and entry.Value.Name or ""
		elseif entry.Type == "ColorPicker" then
			data.Options[index] = entry.Value:ToHex()
		elseif entry.Type == "Dropdown" and entry.Multi then
			local selected = {}
			for _, value in entry.Values do
				if entry.Value[value] then
					selected[#selected + 1] = value
				end
			end
			data.Options[index] = selected
		else
			data.Options[index] = entry.Value
		end
	end

	do
		local getSave = getgenv().getCosmeticSaveData
		if type(getSave) == "function" then
			local ok, cos = pcall(getSave)
			if ok and type(cos) == "table" and next(cos) then
				data.Cosmetics = cos
			end
		end
	end

	return data
end

function Library:ApplyConfig(data)
	for index, value in data.Toggles or {} do
		local entry = self.Toggles[index]
		if entry then
			entry:SetValue(value == true)
		end
	end
	for index, value in data.Options or {} do
		local entry = self.Options[index]
		if not entry then
			continue
		end
		if entry.Type == "Keybind" then
			entry:SetValue(value ~= "" and value or nil)
		elseif entry.Type == "Slider" then
			entry:SetValue(tonumber(value) or entry.Value)
		elseif entry.Type == "ColorPicker" then
			local ok, c = pcall(Color3.fromHex, value)
			if ok then entry:SetValue(c, true) end
		else
			entry:SetValue(value)
		end
	end

	if type(data.Cosmetics) == "table" then
		local apply = getgenv().applyCosmeticLoadData
		if type(apply) == "function" then
			task.defer(function()
				pcall(apply, data.Cosmetics)
			end)
		end
	end
end

function Library:configPath(name)
	return string.format("%s/configs/%s.json", self.Folder, name)
end

function Library:autoloadPath()
	return string.format("%s/autoload.txt", self.Folder)
end

local function validName(name)
	return type(name) == "string" and name ~= "" and string.match(name, "^[%w%-_ ]+$") ~= nil
end

function Library:SaveConfig(name)
	if not fsSupported() then
		return false, "Filesystem unavailable"
	end
	if not validName(name) then
		return false, "Invalid config name"
	end
	ensureFolder(self.Folder .. "/configs")
	local encoded, payload = pcall(HttpService.JSONEncode, HttpService, self:GetConfig())
	if not encoded then
		return false, "Encode failed"
	end
	local written = pcall(writefile, self:configPath(name), payload)
	if not written then
		return false, "Write failed"
	end
	return true, "Saved " .. name
end

function Library:LoadConfig(name)
	if not fsSupported() then
		return false, "Filesystem unavailable"
	end
	if not validName(name) then
		return false, "Invalid config name"
	end
	local path = self:configPath(name)
	if not isfile(path) then
		return false, "No config named " .. name
	end
	local read, raw = pcall(readfile, path)
	if not read then
		return false, "Read failed"
	end
	local decoded, data = pcall(HttpService.JSONDecode, HttpService, raw)
	if not decoded or type(data) ~= "table" then
		return false, "Config is corrupt"
	end
	self:ApplyConfig(data)
	return true, "Loaded " .. name
end

function Library:DeleteConfig(name)
	if not fsSupported() or type(delfile) ~= "function" then
		return false, "Filesystem unavailable"
	end
	if not validName(name) then
		return false, "Invalid config name"
	end
	local path = self:configPath(name)
	if not isfile(path) then
		return false, "No config named " .. name
	end
	local removed = pcall(delfile, path)
	if not removed then
		return false, "Delete failed"
	end
	if self:GetAutoload() == name then
		pcall(delfile, self:autoloadPath())
	end
	return true, "Deleted " .. name
end

function Library:ListConfigs()
	local names = {}
	if not fsSupported() or type(listfiles) ~= "function" then
		return names
	end
	ensureFolder(self.Folder .. "/configs")
	local listed, files = pcall(listfiles, self.Folder .. "/configs")
	if not listed or type(files) ~= "table" then
		return names
	end
	for _, file in files do
		local name = string.match(file, "([^/\\]+)%.json$")
		if name then
			names[#names + 1] = name
		end
	end
	table.sort(names)
	return names
end

function Library:GetAutoload()
	if not fsSupported() then
		return nil
	end
	local path = self:autoloadPath()
	if not isfile(path) then
		return nil
	end
	local read, name = pcall(readfile, path)
	if read and validName(name) then
		return name
	end
	return nil
end

function Library:SetAutoload(name)
	if not fsSupported() then
		return false, "Filesystem unavailable"
	end
	ensureFolder(self.Folder)
	if name == nil or name == "" then
		if type(delfile) == "function" and isfile(self:autoloadPath()) then
			pcall(delfile, self:autoloadPath())
		end
		return true, "Autoload cleared"
	end
	if not validName(name) then
		return false, "Invalid config name"
	end
	local written = pcall(writefile, self:autoloadPath(), name)
	if not written then
		return false, "Write failed"
	end
	return true, "Autoload set to " .. name
end

function Library:LoadAutoloadConfig()
	local name = self:GetAutoload()
	if not name then
		return false, "No autoload config"
	end
	return self:LoadConfig(name)
end

function Library:BuildConfigSection(groupbox)
	local nameInput = groupbox:AddInput("ConfigName", { Text = "Config name", Placeholder = "Name", NoSave = true })
	local picker = groupbox:AddDropdown("ConfigList", { Text = "Config", Values = self:ListConfigs(), NoSave = true })
	local autoloadLabel = groupbox:AddLabel("", true)

	local function refresh()
		picker:SetValues(self:ListConfigs(), true)
		local autoload = self:GetAutoload()
		autoloadLabel:SetText(autoload and "Autoload: " .. autoload or "Autoload: none")
	end

	local function report(ok, message)
		self:Notify(ok and "Configs" or "Config error", message, 2.5)
		refresh()
	end

	groupbox:AddButton({
		Text = "Save",
		Func = function()
			report(self:SaveConfig(nameInput.Value))
		end,
	})
	groupbox:AddButton({
		Text = "Load",
		Func = function()
			report(self:LoadConfig(picker.Value or ""))
		end,
	})
	groupbox:AddButton({
		Text = "Delete",
		Func = function()
			report(self:DeleteConfig(picker.Value or ""))
		end,
	})
	groupbox:AddButton({
		Text = "Set autoload",
		Func = function()
			report(self:SetAutoload(picker.Value))
		end,
	})
	groupbox:AddButton({
		Text = "Clear autoload",
		Func = function()
			report(self:SetAutoload(nil))
		end,
	})

	refresh()
	return groupbox
end

function Library:Unload()
	if self.Unloaded then
		return
	end
	self.Unloaded = true
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	self.Connections = {}
	local window = self.Window
	if not window then
		return
	end
	window.Open = false
	local fade = tween(window.Root, { GroupTransparency = 1 }, Motion.Smooth)
	fade.Completed:Once(function()
		window.Gui:Destroy()
	end)
end

return Library
