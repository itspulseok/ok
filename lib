	local rgbHolder = new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 182),
		Size = UDim2.new(1, 0, 0, 46),
		Parent = popup,
	}, { list(4) })

	local function makeRgbRow(name, chan)
		local row = new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 14),
			Parent = rgbHolder,
		})
		text({
			Size = UDim2.new(0, 12, 1, 0),
			Text = name,
			Font = Fonts.Medium,
			TextSize = 11,
			TextColor3 = Theme.Muted,
			Parent = row,
		})
		local track = new("Frame", {
			BackgroundColor3 = Theme.Track,
			Position = UDim2.fromOffset(16, 6),
			Size = UDim2.new(1, -44, 0, 3),
			Parent = row,
		}, { corner(2) })
		local fill = new("Frame", {
			BackgroundColor3 = Theme.Accent,
			Size = UDim2.new(0, 0, 1, 0),
			Parent = track,
		}, { corner(2) })
		local readout = text({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.new(0, 26, 1, 0),
			Text = "0",
			Font = Fonts.Medium,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = Theme.Text,
			Parent = row,
		})
		local hit = clickable(row)
		return { track = track, fill = fill, readout = readout, hit = hit, chan = chan }
	end

	local rgbRows = {
		makeRgbRow("R", 1),
		makeRgbRow("G", 2),
		makeRgbRow("B", 3),
	}

	local hexBox = new("TextBox", {
		BackgroundColor3 = Theme.Control,
		Position = UDim2.fromOffset(0, 214),
		Size = UDim2.new(1, 0, 0, 20),
		Font = Fonts.Medium,
		TextSize = 11,
		TextColor3 = Theme.Text,
		PlaceholderText = "#FFFFFF",
		PlaceholderColor3 = Theme.Dim,
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = popup,
	}, { corner(4), stroke(Theme.Border, 0.4) })

	local function syncUI()
		local c = entry.Value
		preview.BackgroundColor3 = c
		swatch.BackgroundColor3 = c

		local hh, ss, vv = Color3.toHSV(c)
		entry.Hue, entry.Sat, entry.Vib = hh, ss, vv

		satvib.BackgroundColor3 = Color3.fromHSV(hh, 1, 1)
		svCursor.Position = UDim2.new(ss, 0, 1 - vv, 0)
		hueCursor.Position = UDim2.new(hh, 0, 0.5, 0)

		local vals = {
			math.floor(c.R * 255 + 0.5),
			math.floor(c.G * 255 + 0.5),
			math.floor(c.B * 255 + 0.5),
		}
		for _, row in rgbRows do
			row.fill.Size = UDim2.new(vals[row.chan] / 255, 0, 1, 0)
			row.readout.Text = tostring(vals[row.chan])
		end
		hexBox.Text = "#" .. c:ToHex()
	end

	local open = false
	local function setOpen(state)
		if open == state then return end
		open = state
		if state then
			if window.OpenDropdown and window.OpenDropdown.Close then
				window.OpenDropdown:Close()
			end
			local scale = window.Scale.Scale
			local origin = (swatch.AbsolutePosition - window.Overlay.AbsolutePosition) / scale
			local below = origin.Y + swatch.AbsoluteSize.Y / scale + 4
			local rootH = window.Root.AbsoluteSize.Y / scale
			local y = below
			if below + POPUP_H > rootH then
				y = math.max(origin.Y - POPUP_H - 4, 4)
			end
			local x = origin.X + swatch.AbsoluteSize.X / scale - POPUP_W
			if x < 4 then x = 4 end
			local maxX = window.Root.AbsoluteSize.X / scale - POPUP_W - 4
			if x > maxX then x = maxX end
			popup.Position = UDim2.fromOffset(x, y)
			popup.Visible = true
			tween(popup, { GroupTransparency = 0 }, Motion.Quick)
			syncUI()
		else
			local fade = tween(popup, { GroupTransparency = 1 }, Motion.Quick)
			fade.Completed:Once(function()
				if not open then popup.Visible = false end
			end)
		end
	end

	connect(swatchButton.MouseButton1Click, function()
		if entry.Disabled then return end
		setOpen(not open)
	end)

	local svHit = clickable(satvib)
	local svDragging = false
	local function svApply(x, y)
		local w = satvib.AbsoluteSize.X
		local hh = satvib.AbsoluteSize.Y
		if w <= 0 or hh <= 0 then return end
		local ss = math.clamp((x - satvib.AbsolutePosition.X) / w, 0, 1)
		local vv = 1 - math.clamp((y - satvib.AbsolutePosition.Y) / hh, 0, 1)
		entry.Value = Color3.fromHSV(entry.Hue, ss, vv)
		syncUI()
		fireChanged(entry, entry.Value)
	end
	connect(svHit.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		svDragging = true
		svApply(input.Position.X, input.Position.Y)
	end)
	connect(UserInputService.InputChanged, function(input)
		if not svDragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		svApply(input.Position.X, input.Position.Y)
	end)
	connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			svDragging = false
		end
	end)

	local hueHit = clickable(hue)
	local hueDragging = false
	local function hueApply(x)
		local w = hue.AbsoluteSize.X
		if w <= 0 then return end
		local hh = math.clamp((x - hue.AbsolutePosition.X) / w, 0, 1)
		entry.Value = Color3.fromHSV(hh, entry.Sat, entry.Vib)
		syncUI()
		fireChanged(entry, entry.Value)
	end
	connect(hueHit.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		hueDragging = true
		hueApply(input.Position.X)
	end)
	connect(UserInputService.InputChanged, function(input)
		if not hueDragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		hueApply(input.Position.X)
	end)
	connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			hueDragging = false
		end
	end)

	for _, row in rgbRows do
		local dragging = false
		local function apply(x)
			local w = row.track.AbsoluteSize.X
			if w <= 0 then return end
			local a = math.clamp((x - row.track.AbsolutePosition.X) / w, 0, 1)
			local c = entry.Value
			if row.chan == 1 then
				entry.Value = Color3.new(a, c.G, c.B)
			elseif row.chan == 2 then
				entry.Value = Color3.new(c.R, a, c.B)
			else
				entry.Value = Color3.new(c.R, c.G, a)
			end
			syncUI()
			fireChanged(entry, entry.Value)
		end
		connect(row.hit.InputBegan, function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
			dragging = true
			apply(input.Position.X)
		end)
		connect(UserInputService.InputChanged, function(input)
			if not dragging then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
			apply(input.Position.X)
		end)
		connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
	end

	connect(hexBox.FocusLost, function()
		local raw = hexBox.Text:gsub("#", ""):upper()
		local ok, c = pcall(Color3.fromHex, raw)
		if ok and typeof(c) == "Color3" then
			entry.Value = c
			syncUI()
			fireChanged(entry, c)
		else
			syncUI()
		end
	end)

	connect(UserInputService.InputBegan, function(input)
		if not open then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		local pos = UserInputService:GetMouseLocation()
		local function inside(g)
			local ap, sz = g.AbsolutePosition, g.AbsoluteSize
			return pos.X >= ap.X and pos.X <= ap.X + sz.X and pos.Y >= ap.Y and pos.Y <= ap.Y + sz.Y
		end
		if not inside(swatch) and not inside(popup) then
			setOpen(false)
		end
	end)

	function entry:SetValue(color, silent)
		self.Value = color
		syncUI()
		if not silent then
			fireChanged(self, color)
		end
	end

	function entry:GetValue()
		return self.Value
	end

	function entry:SetDisabled(state)
		self.Disabled = state
		setEnabledLook(label, swatch, not state)
		if state then setOpen(false) end
	end

	syncUI()
	Library.Options[index] = entry
	return entry
end

